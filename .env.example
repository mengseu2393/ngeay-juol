APP_NAME="ngeay juol"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=km
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_CONNECTION=session   # only with SESSION_DRIVER=redis

# Cookie hardening. Defaults are already safe: secure cookies switch on
# automatically when APP_ENV=production, http_only is true, same_site is lax.
# Uncomment only to override (e.g. a production host served over plain HTTP).
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis is pure PHP and ships via Composer; use phpredis only where the
# C extension is actually installed.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_DB=0          # queue + locks
# REDIS_CACHE_DB=1
# REDIS_SESSION_DB=2
# Set a unique REDIS_PREFIX per environment when staging and production
# share one Redis instance (both otherwise derive it from APP_NAME).
# REDIS_PREFIX=rentwise-prod-database-

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

BROWSERSHOT_CHROME_PATH=/usr/bin/google-chrome
# BROWSERSHOT_NODE_BINARY=/usr/bin/node
# BROWSERSHOT_NPM_BINARY=/usr/bin/npm
# BROWSERSHOT_NODE_MODULE_PATH=/absolute/path/to/node_modules

VITE_APP_NAME="${APP_NAME}"

# Comma-separated proxy IPs/CIDRs to trust for X-Forwarded-* (or * when the
# load balancer is the only ingress). Empty = trust none.
TRUSTED_PROXIES=
