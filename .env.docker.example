# Copy to .env.docker and fill in. Consumed by every service in compose.yaml.
#
#   cp .env.docker.example .env.docker
#   docker compose run --rm app php artisan key:generate --show   # paste below

APP_NAME="Ngeay Juol"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_LOCALE=km
APP_FALLBACK_LOCALE=en

# Comma-separated proxy IPs/CIDRs, or * when the load balancer is the only
# ingress. Leave empty and the login throttle keys on the proxy's IP for
# every client. See bootstrap/app.php.
TRUSTED_PROXIES=

# Service names from compose.yaml, not localhost.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rentwise
DB_USERNAME=rentwise
DB_PASSWORD=change-me

# Read by the mysql image on first boot to create the database above.
MYSQL_DATABASE=rentwise
MYSQL_USER=rentwise
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

REDIS_HOST=redis
REDIS_PORT=6379
# predis is a composer package, so no PHP extension is required.
REDIS_CLIENT=predis

# Sessions get their own Redis db (see config/database.php) so a queue flush
# cannot sign every landlord out.
SESSION_DRIVER=redis
SESSION_CONNECTION=session
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Production logging: daily files at error level, not one unbounded debug log.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# `log` silently swallows every notification email — set a real mailer.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"
