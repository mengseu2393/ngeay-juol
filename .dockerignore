# Anything the image should build itself, or must never be baked in.
.git
.github
.env
.env.*
!.env.docker.example
node_modules
vendor
public/build
# Host-only artefacts: a dangling `storage:link` symlink (absolute host path) would be baked in and
# stop the container's own link from being created; host cache files carry host paths.
public/storage
bootstrap/cache/*.php
public/hot
storage/app/exports/*
storage/app/private/*
storage/app/public/*
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
tests
phpunit.xml
graphify-out
*.md
!README.md
docker-compose.override.yml
